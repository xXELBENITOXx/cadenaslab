{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cadenaslab",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadenaslab-db",
      "database_id": "32b238e3-9fbf-4da4-97eb-d5faf51c3f97",
      "migrations_dir": "migrations"
    }
  ]
}
